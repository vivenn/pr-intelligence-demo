DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pr_intelligence?schema=public"
PORT=4000

# GitHub
GITHUB_TOKEN="ghp_your_personal_access_token"
GITHUB_ORG="your-org-name"
# Comma-separated list of repo names (without org prefix) to sync
GITHUB_REPOS="repo-one,repo-two"

# Optional: cron expression for scheduled sync (e.g. every 30 min). Leave unset for manual-only sync.
# SYNC_CRON="*/30 * * * *"

# Optional: comma-separated allowed frontend origins for CORS (defaults to http://localhost:5173)
# CORS_ORIGINS="http://localhost:5173"

# Optional: when set, all /api routes require this value in an X-API-Key header.
# Leave unset to disable auth (local dev / demo). Set the same value as VITE_API_KEY in the frontend.
# API_KEY="change-me-in-production"
